# Postgres connection string (Neon gives you this automatically when you
# add it to your Vercel project — see the deploy guide).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any long random string. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# The public URL of your deployed app (Vercel sets this for you in
# production automatically via VERCEL_URL, but set it explicitly too).
NEXTAUTH_URL="http://localhost:3000"

# Used ONCE by `npm run db:seed` to create the first administrator
# account and the two default companies. Change the password after
# your first login.
ADMIN_EMAIL="you@example.com"
ADMIN_NAME="Your name"
ADMIN_PASSWORD="change-me-please"

# Xero integration (Admin → Xero tab) — see XERO.md for how to get these.
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
XERO_REDIRECT_URI="http://localhost:3000/api/xero/callback"
# 32-byte key used to encrypt Xero tokens at rest. Generate with:
# openssl rand -base64 32
XERO_TOKEN_KEY=""
